<Window x:Class="SDCPervomayDesktop.AppData.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDCPervomayDesktop.AppData" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
            Title="" 
    WindowStartupLocation="CenterOwner" 
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    MinWidth="300"
    MaxWidth="500"
    WindowStyle="None"
    AllowsTransparency="True">
    <Border BorderBrush="Black" BorderThickness="1" Effect="{x:Null}">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Иконка и заголовок -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <materialDesign:PackIcon Name="Icon" Kind="Information" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock Name="TitleText" Text="Заголовок" FontSize="22" FontWeight="Bold" 
                   FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center" Foreground="Black"/>
            </StackPanel>

            <!-- Текст сообщения -->
            <TextBlock Name="MessageText" Grid.Row="1" Text="Текст сообщения" 
               FontSize="16" FontFamily="{StaticResource GothamProFamily}"
               TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="YesButton" Content="Да" Width="80" Height="35" Margin="0,0,10,0"
                Style="{StaticResource MaterialDesignFlatButton}" 
                Click="YesButton_Click" Visibility="Collapsed"/>
                <Button Name="NoButton" Content="Нет" Width="80" Height="35" Margin="0,0,10,0"
                Style="{StaticResource MaterialDesignFlatButton}" 
                Click="NoButton_Click" Visibility="Collapsed"/>
                <Button Name="OkButton" Content="ОК" Width="80" Height="35"
                Style="{StaticResource MaterialDesignFlatButton}" 
                Click="OkButton_Click" IsDefault="True" Foreground="Black"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
