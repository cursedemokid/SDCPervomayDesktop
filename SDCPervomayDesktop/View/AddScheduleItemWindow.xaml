<Window x:Class="SDCPervomayDesktop.View.AddScheduleItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить день" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="День:" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <ComboBox Grid.Row="0" Grid.Column="2" Name="DayCombo" Width="120" FontSize="20" FontFamily="{StaticResource GothamProFamily}">
            <ComboBoxItem Content="Понедельник" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Вторник" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Среда" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Четверг" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Пятница" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Суббота" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <ComboBoxItem Content="Воскресенье" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Начало:" VerticalAlignment="Center" Margin="0,10,0,0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <TextBox Grid.Row="1" Grid.Column="2" Name="StartTimeBox" Text="09:00" Width="120" Margin="0,10,0,0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Конец:" VerticalAlignment="Center" Margin="0,10,0,0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <TextBox Grid.Row="2" Grid.Column="2" Name="EndTimeBox" Text="10:00" Width="120" Margin="0,10,0,0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="OkBtn" Content="OK" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="5" Click="OkBtn_Click"/>
            <Button Name="CancelBtn" Content="Отмена" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="5" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>