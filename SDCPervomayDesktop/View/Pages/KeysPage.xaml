<Page x:Class="SDCPervomayDesktop.View.Pages.KeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SDCPervomayDesktop.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="434" d:DesignWidth="1280"
      Title="KeysPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1" Background="Gray">
                <TextBlock Text="Лавочка" FontSize="20" FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.RowSpan="3" HorizontalAlignment="Left" Background="LightSkyBlue">
                <TextBlock RenderTransformOrigin="0.5,0.5" Text="Окно" FontSize="20" FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш10"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш11"/>
                </Grid>
            </Border>
            <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш12"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш13"/>
                </Grid>
            </Border>
            <Border Grid.Column="5" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш014"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш15"/>
                </Grid>
            </Border>
            <Border Grid.Column="7" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш16"/>
                </Grid>
            </Border>
            <Border Grid.Column="8" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш17"/>
                </Grid>
            </Border>
            <Border Grid.Column="9" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш18"/>
                </Grid>
            </Border>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш01"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш02"/>
                </Grid>
            </Border>
            <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш03"/>
                </Grid>
            </Border>
            <Border Grid.Column="4" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш04"/>
                </Grid>
            </Border>
            <Border Grid.Column="5" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш05"/>
                </Grid>
            </Border>
            <Border Grid.Column="6" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш06"/>
                </Grid>
            </Border>
            <Border Grid.Column="7" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш07"/>
                </Grid>
            </Border>
            <Border Grid.Column="8" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш08"/>
                </Grid>
            </Border>
            <Border Grid.Column="9" BorderBrush="Black" BorderThickness="1">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource GothamProFamily}" FontSize="20" Text="Ш09"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Height="100" Width="100" BorderBrush="Black" BorderThickness="0 2 0 0">
            <Grid HorizontalAlignment="Right" Grid.RowSpan="2" VerticalAlignment="Center" Height="100">
                <TextBlock RenderTransformOrigin="0.5,0.5" Text="Выход" FontSize="20" FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
