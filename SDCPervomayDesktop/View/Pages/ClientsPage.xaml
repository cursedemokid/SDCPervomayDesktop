<Page x:Class="SDCPervomayDesktop.View.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SDCPervomayDesktop.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="434" d:DesignWidth="1280"
      Title="ClientsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="20" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Style="{x:Null}"
                Header="Сортировка по возрасту"
                Width="300"
                FontFamily="{StaticResource GothamProFamily}"
                FontSize="20"
                Grid.Column="1">
                
                <ComboBox Name="FilterCombo">
                    <ComboBoxItem Content="Дети до 18" Name="Kids" FontFamily="{StaticResource GothamProFamily}" FontSize="20"/>
                    <ComboBoxItem Content="Старше 18" Name="Grow" FontFamily="{StaticResource GothamProFamily}" FontSize="20"/>
                    <ComboBoxItem Content="Все" Name="All" FontFamily="{StaticResource GothamProFamily}" FontSize="20"/>
                </ComboBox>
            </GroupBox>

            <Border Grid.Column="3"    
                    CornerRadius="3" 
                    Background="White" 
                    ClipToBounds="False" 
                    UseLayoutRounding="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                      ShadowDepth="0" 
                      Opacity="0.25" 
                      Color="Gray"/>
                </Border.Effect>


                <Grid Background="White" Width="600" Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="SearchTextBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="1" Width="50" Height="50" Padding="0" Background="White" BorderThickness="0" >
                        <Button.Content>
                            <Image Source="/Resources/search.png"  Grid.Column="1" Width="45" Height="45"/>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <Button Name="ReceptionBtn" Grid.Column="5" Height="60" Background="White" Content="Записать посетителя"
                    FontFamily="{StaticResource GothamProFamily}" FontSize="20" Click="ReceptionBtn_Click" Visibility="Visible"/>
        </Grid>

        <ListView Name="ClientsListView" Grid.Row="4" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="20 0 20 0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding FullName}"/>
                    <GridViewColumn Header="Номер телефона" DisplayMemberBinding="{Binding PhoneNumber}"/>
                    <GridViewColumn Header="Дата рождения" DisplayMemberBinding="{Binding BirthDate}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Name="AdminGrid" Grid.Row="2" Visibility="Visible" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="EditBtn" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5" Click="EditBtn_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Редактировать" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/edit.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Name="AddBtn" Grid.Column="2" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5" Click="AddBtn_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/more.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Name="DeleteBtn" Grid.Column="4" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5" Click="DeleteBtn_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удалить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/bin.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</Page>
