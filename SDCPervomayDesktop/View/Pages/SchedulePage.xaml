<Page x:Class="SDCPervomayDesktop.View.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SDCPervomayDesktop.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="434" d:DesignWidth="1280"
        Title="ClientsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="MondayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Пн" MouseDown="MondayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Name="TuesdayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Вт" MouseDown="TuesdayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Name="WednesdayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Ср" MouseDown="WednesdayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Name="ThursdayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Чт" MouseDown="ThursdayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="8" Name="FridayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Пт" MouseDown="FridayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="10" Name="SaturdayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Сб" MouseDown="SaturdayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="12" Name="SundayTbl" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Text="Вс" MouseDown="SundayTbl_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid Name="AdminGrid" Grid.Row="2" Visibility="Visible" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="EditBtn" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5" Click="EditBtn_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Редактировать" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/edit.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Name="AddBtn" Grid.Column="2" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5" Click="AddBtn_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/more.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Name="DeleteBtn" Grid.Column="4" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Background="White" Padding="5">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удалить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0 0 10 0"/>
                        <Image Source="/Resources/bin.png" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
        <ListBox Grid.Row="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border 
                            CornerRadius="10" 
                            Background="White" 
                            ClipToBounds="False" 
                            UseLayoutRounding="True"
                            Margin="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" 
                                              ShadowDepth="0" 
                                              Opacity="0.25" 
                                              Color="Gray"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <Image Source="{Binding Source}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Name}"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="10 0 10 0">
                                    <TextBlock HorizontalAlignment="Left" Text="Время:"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Time}"/>
                                </Grid>
                                <Grid Grid.Row="4" Margin="10 0 10 0">
                                    <TextBlock HorizontalAlignment="Left" Text="Тренер:"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding CoachFullName}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid>
            
        </Grid>
    </Grid>
</Page>
