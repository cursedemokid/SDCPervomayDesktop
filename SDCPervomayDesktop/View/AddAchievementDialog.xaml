<Window x:Class="SDCPervomayDesktop.View.AddAchievementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить заслугу" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Текст заслуги:" FontSize="16" Margin="5" FontFamily="{StaticResource GothamProFamily}"/>
        <TextBox x:Name="AchievementTextBox" Grid.Row="1" Width="300" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" Margin="5" FontFamily="{StaticResource GothamProFamily}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="OK"  Margin="5" Click="Ok_Click" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Content="Отмена"  Margin="5" Click="Cancel_Click" FontFamily="{StaticResource GothamProFamily}"/>
        </StackPanel>
    </Grid>
</Window>