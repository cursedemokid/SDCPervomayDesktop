<Window x:Class="SDCPervomayDesktop.View.AddEditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDCPervomayDesktop.View"
        mc:Ignorable="d"
        Title="AddEditScheduleWindow" Width="800" SizeToContent="Height">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Название" BorderThickness="2" BorderBrush="Black">
            <TextBox FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox Grid.Row="1" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Описание" BorderThickness="2" BorderBrush="Black">
            <TextBox FontSize="20" FontFamily="{StaticResource GothamProFamily}" Height="115" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
        </GroupBox>

        <GroupBox Grid.Row="2" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Тренер" BorderThickness="2" BorderBrush="Black">
            <ComboBox FontSize="20" FontFamily="{StaticResource GothamProFamily}" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="Расписание" Margin="10 10 0 0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="4" CornerRadius="10">
            <ListBox Name="ScheduleListBox" Height="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border 
                         CornerRadius="10" 
                         Background="White" 
                         ClipToBounds="False" 
                         UseLayoutRounding="True"
                         Margin="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" 
                                               ShadowDepth="0" 
                                               Opacity="0.25" 
                                               Color="Gray"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="10" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DayName}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StartTime}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <TextBlock Grid.Column="4" Text="{Binding EndTime}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <Button Padding="2" Grid.Column="6">
                                    <Button.Content>
                                        <Image Source="/Resources/edit.png" Width="45" Height="45"/>
                                    </Button.Content>
                                </Button>
                                <Button Padding="2" Grid.Column="8">
                                    <Button.Content>
                                        <Image Source="/Resources/bin.png" Width="45" Height="45"/>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Button Margin="0 10 0 0" Name="AddDayBtn" Grid.Row="5" Content="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="250"/>

        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Изображение" Margin="10 10 0 0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>

            <Border BorderBrush="Black" BorderThickness="2" Grid.Row="2" CornerRadius="10">
                <Image Width="150" Height="150"/>
            </Border>
            
            <Button Name="AddImageBtn" Grid.Row="5" Content="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="250"/>
        </Grid>

        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="AddBtn" Grid.Column="1" Content="Добавить" Click="AddBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="SaveBtn" Grid.Column="1" Content="Сохранить" Click="SaveBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="CancelBtn" Grid.Column="3" Content="Отмена" Click="CancelBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </Grid>
    </Grid>
</Window>
