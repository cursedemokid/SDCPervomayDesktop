<Window x:Class="SDCPervomayDesktop.View.AddEditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание секции" Width="800" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Секция" BorderThickness="2" BorderBrush="Black">
            <ComboBox x:Name="SectionCombo" FontSize="20" FontFamily="{StaticResource GothamProFamily}" DisplayMemberPath="Title" SelectedValuePath="Id"/>
        </GroupBox>

        <TextBlock Grid.Row="1" Text="Расписание" Margin="10 10 0 0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="2" CornerRadius="10">
            <ListBox Name="ScheduleListBox" Height="150" 
                     SelectionMode="Single" 
                     BorderThickness="0" 
                     Background="Transparent"
                     HorizontalContentAlignment="Left">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Left"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="White" ClipToBounds="False" UseLayoutRounding="True" Margin="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DayName}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StartTimeString}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <TextBlock Grid.Column="3" Text="-" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <TextBlock Grid.Column="4" Text="{Binding EndTimeString}" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                <Button Padding="2" Grid.Column="6" Width="35" Height="35" Click="EditScheduleItem_Click" Tag="{Binding}">
                                    <Image Source="/Resources/edit.png" Width="30" Height="30"/>
                                </Button>
                                <Button Padding="2" Grid.Column="8" Width="35" Height="35" Click="DeleteScheduleItem_Click" Tag="{Binding}">
                                    <Image Source="/Resources/bin.png" Width="30" Height="30"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Button Name="AddDayBtn" Click="AddDayBtn_Click" Margin="0 10 0 0" Grid.Row="3" Content="Добавить день" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="250"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="AddBtn" Grid.Column="1" Content="Добавить" Click="AddBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="SaveBtn" Grid.Column="1" Content="Сохранить" Click="SaveBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="CancelBtn" Grid.Column="3" Content="Отмена" Click="CancelBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </Grid>
    </Grid>
</Window>