<Window x:Class="SDCPervomayDesktop.View.AddEditSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Секция" Width="800" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="TitleGroupBox" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Название" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="TitleTextBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox x:Name="DescGroupBox" Grid.Row="1" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Описание" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="DescTextBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Height="115" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
        </GroupBox>

        <GroupBox x:Name="TrainerGroupBox" Grid.Row="2" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Тренер" BorderThickness="2" BorderBrush="Black">
            <ComboBox x:Name="TrainerCombo" FontSize="20" FontFamily="{StaticResource GothamProFamily}" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="Изображение" Margin="10 10 0 0" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="4" CornerRadius="10">
            <Image x:Name="PreviewImage" Width="150" Height="150"/>
        </Border>
        <Button Margin="0 10 0 0" Name="AddImageBtn" Grid.Row="5" Content="Добавить" Click="AddImageBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="250"/>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="AddBtn" Grid.Column="1" Content="Добавить" Click="AddBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="SaveBtn" Grid.Column="1" Content="Сохранить" Click="SaveBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="CancelBtn" Grid.Column="3" Content="Отмена" Click="CancelBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </Grid>
    </Grid>
</Window>