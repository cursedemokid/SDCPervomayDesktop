<Window x:Class="SDCPervomayDesktop.View.AddParentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить родителя" Width="450" SizeToContent="Height" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Фамилия -->
        <GroupBox Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" 
                  Header="Фамилия" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="LastNameBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <!-- Имя -->
        <GroupBox Grid.Row="1" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" 
                  Header="Имя" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="FirstNameBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <!-- Отчество -->
        <GroupBox Grid.Row="2" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" 
                  Header="Отчество" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="PatronymicBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <!-- Телефон -->
        <GroupBox Grid.Row="3" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" 
                  Header="Номер телефона" BorderThickness="2" BorderBrush="Black">
            <TextBox x:Name="PhoneBox" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <!-- Кнопки -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Добавить" Click="AddBtn_Click" 
                    FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="120"/>
            <Button Grid.Column="3" Content="Отмена" Click="CancelBtn_Click" 
                    FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="120"/>
        </Grid>
    </Grid>
</Window>