<Window x:Class="SDCPervomayDesktop.View.AddEditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDCPervomayDesktop.View"
        mc:Ignorable="d"
        Title="AddEditClientWindow" Width="800" SizeToContent="Height">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Фамилия" BorderThickness="2" BorderBrush="Black">
            <TextBox Name="LastNameTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox Grid.Row="1" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Имя" BorderThickness="2" BorderBrush="Black">
            <TextBox Name="FirstNameTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox Grid.Row="2" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Отчество" BorderThickness="2" BorderBrush="Black">
            <TextBox Name="PatronymicTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox Grid.Row="3" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Дата рождения" BorderThickness="2" BorderBrush="Black">
            <DatePicker Name="BirthDateDp" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <GroupBox Grid.Row="4" Style="{x:Null}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Header="Номер телефона" BorderThickness="2" BorderBrush="Black">
            <TextBox Name="PhoneNumberTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </GroupBox>

        <Grid Grid.Row="5" Name="IsYoung" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <GroupBox Style="{x:Null}" Header="Родитель" FontSize="20" FontFamily="{StaticResource GothamProFamily}" BorderThickness="2" BorderBrush="Black">
                <ComboBox Name="GrowClientsCmb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            </GroupBox>
            
            <Button Name="AddParent" Margin="0 10 0 10" Grid.Row="1" Content="Добавить родителя" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Width="250" HorizontalAlignment="Right" Click="AddParent_Click"/>
        </Grid>
        
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Name="AddBtn" Grid.Column="1" Content="Добавить" Click="SaveBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="SaveBtn" Grid.Column="1" Content="Сохранить" Click="SaveBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            <Button Name="CancelBtn" Grid.Column="3" Content="Отмена" Click="CancelBtn_Click" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
        </Grid>
    </Grid>
</Window>
